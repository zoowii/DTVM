;; Self comparisons must preserve NaN semantics, local updates and both calls.
(module
 (global $calls (mut i32) (i32.const 0))
 (func $effect (result f64)
  (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
  (f64.convert_i32_u (global.get $calls)))
 (func (export "effects") (result i32)
  (global.set $calls (i32.const 0))
  (drop (f64.eq (call $effect) (call $effect)))
  (global.get $calls))
 (func (export "distinct") (param f64 f64) (result i32)
  (f64.eq (local.get 0) (local.get 1)))
 (func (export "f32_eq") (param f32) (result i32) (f32.eq (local.get 0) (local.get 0)))
 (func (export "f32_eq_branch") (param f32) (result i32)
  (block $taken (br_if $taken (f32.eq (local.get 0) (local.get 0))) (return (i32.const 19))) (i32.const 37))
 (func (export "f32_ne") (param f32) (result i32) (f32.ne (local.get 0) (local.get 0)))
 (func (export "f32_ne_branch") (param f32) (result i32)
  (block $taken (br_if $taken (f32.ne (local.get 0) (local.get 0))) (return (i32.const 19))) (i32.const 37))
 (func (export "f64_eq") (param f64) (result i32) (f64.eq (local.get 0) (local.get 0)))
 (func (export "f64_eq_branch") (param f64) (result i32)
  (block $taken (br_if $taken (f64.eq (local.get 0) (local.get 0))) (return (i32.const 19))) (i32.const 37))
 (func (export "f64_ne") (param f64) (result i32) (f64.ne (local.get 0) (local.get 0)))
 (func (export "f64_ne_branch") (param f64) (result i32)
  (block $taken (br_if $taken (f64.ne (local.get 0) (local.get 0))) (return (i32.const 19))) (i32.const 37))
)
(assert_return (invoke "f32_eq" (f32.const 0)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const 0)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const 0)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const 0)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const -0)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const -0)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const -0)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const -0)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const 1)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const 1)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const 1)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const 1)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const -1)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const -1)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const -1)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const -1)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const inf)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const inf)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const inf)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const inf)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const -inf)) (i32.const 1))
(assert_return (invoke "f32_eq_branch" (f32.const -inf)) (i32.const 37))
(assert_return (invoke "f32_ne" (f32.const -inf)) (i32.const 0))
(assert_return (invoke "f32_ne_branch" (f32.const -inf)) (i32.const 19))
(assert_return (invoke "f32_eq" (f32.const nan:0x400001)) (i32.const 0))
(assert_return (invoke "f32_eq_branch" (f32.const nan:0x400001)) (i32.const 19))
(assert_return (invoke "f32_ne" (f32.const nan:0x400001)) (i32.const 1))
(assert_return (invoke "f32_ne_branch" (f32.const nan:0x400001)) (i32.const 37))
(assert_return (invoke "f32_eq" (f32.const nan:0x1)) (i32.const 0))
(assert_return (invoke "f32_eq_branch" (f32.const nan:0x1)) (i32.const 19))
(assert_return (invoke "f32_ne" (f32.const nan:0x1)) (i32.const 1))
(assert_return (invoke "f32_ne_branch" (f32.const nan:0x1)) (i32.const 37))
(assert_return (invoke "f64_eq" (f64.const 0)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const 0)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const 0)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const 0)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const -0)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const -0)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const -0)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const -0)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const 1)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const 1)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const 1)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const 1)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const -1)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const -1)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const -1)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const -1)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const inf)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const inf)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const inf)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const inf)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const -inf)) (i32.const 1))
(assert_return (invoke "f64_eq_branch" (f64.const -inf)) (i32.const 37))
(assert_return (invoke "f64_ne" (f64.const -inf)) (i32.const 0))
(assert_return (invoke "f64_ne_branch" (f64.const -inf)) (i32.const 19))
(assert_return (invoke "f64_eq" (f64.const nan:0x8000000000001)) (i32.const 0))
(assert_return (invoke "f64_eq_branch" (f64.const nan:0x8000000000001)) (i32.const 19))
(assert_return (invoke "f64_ne" (f64.const nan:0x8000000000001)) (i32.const 1))
(assert_return (invoke "f64_ne_branch" (f64.const nan:0x8000000000001)) (i32.const 37))
(assert_return (invoke "f64_eq" (f64.const nan:0x1)) (i32.const 0))
(assert_return (invoke "f64_eq_branch" (f64.const nan:0x1)) (i32.const 19))
(assert_return (invoke "f64_ne" (f64.const nan:0x1)) (i32.const 1))
(assert_return (invoke "f64_ne_branch" (f64.const nan:0x1)) (i32.const 37))
(assert_return (invoke "effects") (i32.const 2))
(assert_return (invoke "distinct" (f64.const 1) (f64.const 2)) (i32.const 0))
