;; Mutable versions must survive non-selected side exits and join/backedges.
(module
 (func $clobber (param i64) (result i64) (i64.add (local.get 0) (i64.const 100)))
 (func (export "side_exit") (param $take i32) (result i64)
  (local $x i64) (local $y i64)
  (local.set $x (i64.const 11)) (local.set $y (i64.const 19))
  (block $exit
   (br_if $exit (local.get $take))
   (local.set $x (i64.const 37)) (local.set $y (i64.const 59)))
  (call $clobber (i64.add (i64.mul (local.get $x) (i64.const 3)) (i64.mul (local.get $y) (i64.const 5)))))
 (func (export "loop") (param $n i32) (result i64)
  (local $i i32) (local $x i64) (local $s i64)
  (local.set $x (i64.const 11))
  (loop $again
   (block $skip
    (br_if $skip (i32.and (local.get $i) (i32.const 1)))
    (local.set $x (i64.add (i64.mul (local.get $x) (i64.const 3)) (i64.const 1))))
   (local.set $s (i64.add (local.get $s) (local.get $x)))
   (br_if $again (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
  (call $clobber (local.get $s)))
 (func (export "alias") (param $x i64) (param $y i32) (result i64)
  (local $a i64) (local $b i32)
  (local.set $a (local.get $x))
  (block $skip
   (br_if $skip (i32.eqz (local.get $y)))
   (local.set $b (i32.add (local.get $y) (i32.const -1))))
  (i64.add (local.get $a) (i64.extend_i32_u (local.get $b))))
)
(assert_return (invoke "side_exit" (i32.const 0)) (i64.const 506))
(assert_return (invoke "side_exit" (i32.const 1)) (i64.const 228))
(assert_return (invoke "side_exit" (i32.const -1)) (i64.const 228))
(assert_return (invoke "loop" (i32.const 1)) (i64.const 134))
(assert_return (invoke "loop" (i32.const 2)) (i64.const 168))
(assert_return (invoke "loop" (i32.const 3)) (i64.const 271))
(assert_return (invoke "loop" (i32.const 16)) (i64.const 226412))
(assert_return (invoke "loop" (i32.const 100)) (i64.const -3461709067745545562))
(assert_return (invoke "alias" (i64.const -1) (i32.const -1)) (i64.const 4294967293))
(assert_return (invoke "alias" (i64.const -1) (i32.const 0)) (i64.const -1))
(assert_return (invoke "alias" (i64.const -1) (i32.const 1)) (i64.const -1))
(assert_return (invoke "alias" (i64.const -1) (i32.const 2147483647)) (i64.const 2147483645))
(assert_return (invoke "alias" (i64.const 0) (i32.const -1)) (i64.const 4294967294))
(assert_return (invoke "alias" (i64.const 0) (i32.const 0)) (i64.const 0))
(assert_return (invoke "alias" (i64.const 0) (i32.const 1)) (i64.const 0))
(assert_return (invoke "alias" (i64.const 0) (i32.const 2147483647)) (i64.const 2147483646))
(assert_return (invoke "alias" (i64.const 4294967296) (i32.const -1)) (i64.const 8589934590))
(assert_return (invoke "alias" (i64.const 4294967296) (i32.const 0)) (i64.const 4294967296))
(assert_return (invoke "alias" (i64.const 4294967296) (i32.const 1)) (i64.const 4294967296))
(assert_return (invoke "alias" (i64.const 4294967296) (i32.const 2147483647)) (i64.const 6442450942))
(assert_return (invoke "alias" (i64.const 9223372036854775807) (i32.const -1)) (i64.const -9223372032559808515))
(assert_return (invoke "alias" (i64.const 9223372036854775807) (i32.const 0)) (i64.const 9223372036854775807))
(assert_return (invoke "alias" (i64.const 9223372036854775807) (i32.const 1)) (i64.const 9223372036854775807))
(assert_return (invoke "alias" (i64.const 9223372036854775807) (i32.const 2147483647)) (i64.const -9223372034707292163))
