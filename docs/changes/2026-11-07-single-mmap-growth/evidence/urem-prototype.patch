+MInstruction *MIRPeephole::foldU32MagicURem(MInstruction *Inst) {
+  if (Inst->getOpcode() != OP_urem) {
+    return nullptr;
+  }
+  MType *Ty = Inst->getType();
+  if (!Ty || !Ty->isI32()) {
+    return nullptr;
+  }
+  MInstruction *LHS = Inst->getOperand<0>();
+  MInstruction *RHS = Inst->getOperand<1>();
+  llvm::APInt RV;
+  if (!matchIntConstLookThrough(RHS, RV) || RV.getBitWidth() != 32 ||
+      !tryU32MagicUDiv(static_cast<uint32_t>(RV.getZExtValue()))) {
+    return nullptr;
+  }
+  // The remainder needs the dividend both in the quotient and subtraction.
+  // Wasm handleIDiv materializes source expressions into a local first;
+  // direct MIR callers must not duplicate effects or trapping trees.
+  if (!isNontrappingPureExpr(LHS)) {
+    return nullptr;
+  }
+  MInstruction *Q = foldU32MagicUDiv(makeBin(OP_udiv, Ty, LHS, RHS));
+  if (!Q) {
+    return nullptr;
+  }
+  MInstruction *Divisor = makeIntConst(Ty, RV.getZExtValue());
+  return makeBin(OP_sub, Ty, LHS, makeBin(OP_mul, Ty, Q, Divisor));
+}
