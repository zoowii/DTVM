; RUN: ircompiler %s -f 0 --args 9 | FileCheck %s -check-prefix REM8
; RUN: ircompiler %s -f 0 --args 8 | FileCheck %s -check-prefix REM8Z
; RUN: ircompiler %s -f 0 --args -1 | FileCheck %s -check-prefix REM8M
; RUN: ircompiler %s -f 1 --args 9 | FileCheck %s -check-prefix DIV8
; RUN: ircompiler %s -f 1 --args 8 | FileCheck %s -check-prefix DIV8E
; RUN: ircompiler %s -f 2 --args 10 | FileCheck %s -check-prefix REM6
; RUN: ircompiler %s -f 3 --args -5 | FileCheck %s -check-prefix SREMS
; RUN: ircompiler %s -f 4 --args 42 | FileCheck %s -check-prefix DIV1
; RUN: ircompiler %s -f 5 --args 42 | FileCheck %s -check-prefix REM1

; REM8: 0x1:i32
; REM8Z: 0x0:i32
; REM8M: 0x7:i32
; DIV8: 0x1:i32
; DIV8E: 0x1:i32
; REM6: 0x4:i32
; SREMS: 0xfffffffb:i32
; DIV1: 0x2a:i32
; REM1: 0x0:i32

func %0 (i32) -> i32 {
    var $1 i32
@0:
    $1 = urem ($0, const.i32 8)
    return $1
}

func %1 (i32) -> i32 {
    var $1 i32
@0:
    $1 = udiv ($0, const.i32 8)
    return $1
}

func %2 (i32) -> i32 {
    var $1 i32
@0:
    $1 = urem ($0, const.i32 6)
    return $1
}

func %3 (i32) -> i32 {
    var $1 i32
@0:
    $1 = srem ($0, const.i32 8)
    return $1
}

func %4 (i32) -> i32 {
    var $1 i32
@0:
    $1 = udiv ($0, const.i32 1)
    return $1
}

func %5 (i32) -> i32 {
    var $1 i32
@0:
    $1 = urem ($0, const.i32 1)
    return $1
}
