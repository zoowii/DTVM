;; Independent variable-add candidate. All operands are runtime parameters.
(module
  (memory 1)
  (data (i32.const 0) "\aa")
  (data (i32.const 16) "\bb")
  (func (export "add") (param i32 i32) (result i32)
    (i32.add (local.get 0) (local.get 1)))
  (func (export "same") (param i32) (result i32)
    (i32.add (local.get 0) (local.get 0)))
  (func (export "both_live") (param i32 i32) (result i32)
    (i32.xor
      (i32.add (local.get 0) (local.get 1))
      (i32.xor (local.get 0) (local.get 1))))
  (func (export "load") (param i32 i32) (result i32)
    (i32.load8_u (i32.add (local.get 0) (local.get 1))))
  (func (export "load_offset") (param i32 i32) (result i32)
    (i32.load offset=16 (i32.add (local.get 0) (local.get 1))))
  (func (export "i64_add") (param i64 i64) (result i64)
    (i64.add (local.get 0) (local.get 1)))
)
(assert_return (invoke "add" (i32.const -16) (i32.const 16)) (i32.const 0))
(assert_return (invoke "add" (i32.const 2147483647) (i32.const 1)) (i32.const -2147483648))
(assert_return (invoke "add" (i32.const -1) (i32.const -1)) (i32.const -2))
(assert_return (invoke "same" (i32.const -2147483648)) (i32.const 0))
(assert_return (invoke "both_live" (i32.const -1) (i32.const 1)) (i32.const -2))
(assert_return (invoke "both_live" (i32.const 7) (i32.const 9)) (i32.const 30))
(assert_return (invoke "load" (i32.const -16) (i32.const 16)) (i32.const 170))
(assert_return (invoke "load" (i32.const -16) (i32.const 32)) (i32.const 187))
;; wrap(-16 + 8) == 0xfffffff8; the separate offset 16 must NOT wrap.
(assert_trap (invoke "load_offset" (i32.const -16) (i32.const 8)) "out of bounds memory access")
(assert_return (invoke "i64_add" (i64.const -1) (i64.const 1)) (i64.const 0))
